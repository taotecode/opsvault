# 铂尔分服务器资产管理平台 · 环境变量示例
# 复制为 .env 并按需修改；.env 已被 gitignore。

# 服务端口与对外地址（用于快速连接命令与安装完成提示）
PORT=8080
BASE_URL=http://localhost:8080

# 数据目录（SQLite 文件、master key、安装锁）
DATA_DIR=./data

# 数据库：sqlite（默认）或 postgres
DB_DRIVER=sqlite
# PostgreSQL 连接串（DB_DRIVER=postgres 时必填）
DATABASE_URL=postgres://boerfen:boerfen@localhost:5432/boerfen

# 主密钥（base64 编码 32 字节）。留空则首次启动自动生成 data/master.key（0600）
# 生产环境建议显式提供并安全备份；丢失将无法解密凭据。
MASTER_KEY=

# 会话与敏感操作
SESSION_DAYS=7
REVEAL_WINDOW_MINUTES=5

# 指定目录的 TLS 反代终止；如无则留空
TRUST_PROXY=

# 更新检查（GitHub Releases）；不启用可留空
GITHUB_REPO=
UPDATE_CHECK=false

# 非交互安装（可选）：首次启动时若检测到这些变量且无管理员，自动创建并锁定安装入口
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 强制锁定安装入口（即使通过 env 安装）
INSTALL_LOCK=false

# 日志级别
LOG_LEVEL=info
